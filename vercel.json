{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    {
      "source": "/newconcret-construccion.html",
      "destination": "/construccion/",
      "permanent": true
    },
    {
      "source": "/mantenimiento/productos-quimicos/sistema-3-pasos",
      "destination": "/proteccion/",
      "permanent": true
    },
    {
      "source": "/mantenimiento/productos-quimicos/sistema-3-pasos/",
      "destination": "/proteccion/",
      "permanent": true
    },
    {
      "source": "/mantenimiento/productos-quimicos/formula-nc",
      "destination": "/proteccion/",
      "permanent": true
    },
    {
      "source": "/mantenimiento/productos-quimicos/formula-nc/",
      "destination": "/proteccion/",
      "permanent": true
    },
    {
      "source": "/assets/docs/sistema-3-pasos-nc-1784565561209.pdf",
      "destination": "/assets/docs/formula-nc-1784565561209.pdf",
      "permanent": true
    },
    {
      "source": "/assets/docs/sistema-3-pasos-nc-garantia.pdf",
      "destination": "/assets/docs/formula-nc-garantia.pdf",
      "permanent": true
    },
    {
      "source": "/assets/docs/sistema-3-pasos-nc-mantenimiento.pdf",
      "destination": "/assets/docs/formula-nc-mantenimiento.pdf",
      "permanent": true
    },
    {
      "source": "/assets/img/hero/mantenimiento-quimicos-sistema-3-pasos.webp",
      "destination": "/assets/img/hero/mantenimiento-quimicos-formula-nc.webp",
      "permanent": true
    },
    {
      "source": "/assets/img/hero/mantenimiento-quimicos-sistema-3-pasos-mobile.webp",
      "destination": "/assets/img/hero/mantenimiento-quimicos-formula-nc-mobile.webp",
      "permanent": true
    },
    {
      "source": "/pulido/productos-quimicos/detergentes",
      "destination": "/pulido/productos-quimicos/desengrasantes/",
      "permanent": true
    },
    {
      "source": "/pulido/productos-quimicos/detergentes/",
      "destination": "/pulido/productos-quimicos/desengrasantes/",
      "permanent": true
    },
    {
      "source": "/blog/errores-comunes-al-sellar-juntas",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/blog/errores-comunes-al-sellar-juntas/",
      "destination": "/blog/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).(mp4|webm)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
