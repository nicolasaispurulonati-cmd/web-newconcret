{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "framework": null,
  "redirects": [
    { "source": "/newconcret-construccion.html", "destination": "/construccion/", "permanent": true },
    { "source": "/mantenimiento/productos-quimicos/sistema-3-pasos", "destination": "/proteccion/", "permanent": true },
    { "source": "/mantenimiento/productos-quimicos/sistema-3-pasos/", "destination": "/proteccion/", "permanent": true },
    { "source": "/pulido/productos-quimicos/detergentes", "destination": "/pulido/productos-quimicos/desengrasantes/", "permanent": true },
    { "source": "/pulido/productos-quimicos/detergentes/", "destination": "/pulido/productos-quimicos/desengrasantes/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/(.*).(mp4|webm)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, must-revalidate" }
      ]
    },
    {
      "source": "/(.*).html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/(.*)/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
