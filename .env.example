# NEWCONCRET — configuración del panel admin (LOCAL)
# Copiá este archivo a ".env" y generá los valores con:
#   npm run admin:password -- "tu-contraseña-segura"
#
# ⚠️ NUNCA commitees ni deploys el archivo .env real. Solo vive en la PC de la empresa.

# Usuario del panel (cosmético; el secreto real es la contraseña)
ADMIN_USER=admin

# Hash scrypt de la contraseña, formato "salt:hash". Lo genera set-admin-password.js
ADMIN_PASSWORD_HASH=

# Secreto aleatorio para firmar las sesiones. Lo genera set-admin-password.js
SESSION_SECRET=

# Opcionales:
# HOST=127.0.0.1   # interfaz donde escucha el panel (por defecto solo localhost)
# PORT=8080
# COOKIE_SECURE=true   # fuerza la cookie de sesión solo-HTTPS. Por defecto se
#                      # activa sola si HOST no es localhost. Ponela en true si
#                      # el HTTPS lo termina un reverse proxy (nginx/Cloudflare).
